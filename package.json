{
  "name": "landnr",
  "version": "1.0.0",
  "private": true,
  "description": "A self-contained build of landonorris.com reconstructed from the raw page capture in /source.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node server.mjs --watch",
    "start": "node server.mjs",
    "preview": "node scripts/build.mjs && node server.mjs",
    "check": "node scripts/build.mjs --check",
    "smoke": "node scripts/build.mjs && node scripts/dev/smoke-all.mjs",
    "smoke:one": "node scripts/dev/smoke.mjs",
    "verify": "node scripts/build.mjs --quiet && node scripts/dev/verify-engine.mjs",
    "vendor": "bash scripts/vendor/fetch.sh",
    "vendor:status": "bash scripts/vendor/inspect.sh"
  },
  "dependencies": {},
  "devDependencies": {}
}
